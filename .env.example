# ---------------------------------------------------------------------------
# Machiya / RentNear — copy to .env and adjust. Never commit .env.
# Every value below has a working local default; nothing here is a real secret.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# --- Postgres + PostGIS ----------------------------------------------------
POSTGRES_USER=machiya
POSTGRES_PASSWORD=machiya
POSTGRES_DB=machiya
POSTGRES_PORT=5432
# Host-side URL (pnpm dev, prisma CLI). Inside compose, host is `postgis`.
DATABASE_URL=postgresql://machiya:machiya@localhost:5432/machiya?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO in dev, Cloudflare R2 in prod) ------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=machiya-listings
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public reads are served from the variants/ prefix only; originals stay private.
S3_PUBLIC_BASE_URL=http://localhost:9000/machiya-listings
# Keep the uploaded original after derivatives are written. Off by default:
# the originals prefix is private and nothing serves from it.
KEEP_ORIGINALS=false

# --- Mail (MailHog in dev) -------------------------------------------------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Machiya <no-reply@machiya.local>

# How often the worker looks for enquiry notifications nothing is sending.
# Two minutes: a dropped notification is invisible to everybody, so nobody is
# watching a spinner and the scan can be cheap. See DECISIONS.md D68.
NOTIFY_RECONCILE_INTERVAL_MS=120000

# --- Web app location (verification and reset links point back here) -------
WEB_APP_URL=http://localhost:5173

# --- Auth (Better Auth, self-hosted) --------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-replace-me-with-32-plus-chars
BETTER_AUTH_URL=http://localhost:4000
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
# Comma-separated subset of: email,google,github
AUTH_ENABLED_PROVIDERS=email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Geocoding (self-hosted Nominatim; see DECISIONS.md D26) ---------------
# nominatim is the only value. The variable exists so provider selection in the
# adapter stays explicit and swappable rather than implicit in the code.
GEOCODE_PROVIDER=nominatim
NOMINATIM_PORT=7070
NOMINATIM_URL=http://localhost:7070
NOMINATIM_PASSWORD=nominatim
NOMINATIM_THREADS=4
# There is deliberately no PUBLIC_NOMINATIM_URL. It was declared here and read
# by nothing — the adapter only ever reads NOMINATIM_URL — and a variable that
# looks like a supported escape hatch and is not is worse than no variable (the
# same reasoning that deleted the ALLOW_PUBLIC_OSRM pair). To fall back to the
# public instance, point NOMINATIM_URL at it and put a REAL contact address in
# the user agent first: it answers 403 to the placeholder below, which is how
# this was found.
NOMINATIM_USER_AGENT=Machiya/0.1 (contact@example.com)

# --- Routing (OSRM, self-hosted) ------------------------------------------
# 5000 is AirPlay Receiver on macOS, so the default sits out of its way.
OSRM_CAR_PORT=5100
OSRM_BIKE_PORT=5001
OSRM_CAR_URL=http://localhost:5100
OSRM_BIKE_URL=http://localhost:5001

# --- OSM artifacts --------------------------------------------------------
# Written by `pnpm bootstrap`. Its `epoch` prefixes every cached route, POI set
# and geocode, so a rebuild strands the old entries rather than serving them.
# Relative to the process cwd; compose overrides it to /osm/manifest.json.
GEO_MANIFEST_PATH=osm-data/manifest.json

# --- POIs (Overpass) ------------------------------------------------------
# Self-hosted, in the `geo` compose profile, from the same merged extract that
# feeds OSRM and Nominatim. LEAVE OVERPASS_URL UNSET: unset means the local
# instance in both places — the compose service name inside the network, and
# the published port for a host-run API. Setting it overrides BOTH.
#
# A public mirror is a fallback for when the geo profile is not up, never the
# default (see docs/geo.md). The main instance answers 406 to every User-Agent
# except curl's own, so if you must, use a mirror that does not:
# OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
OVERPASS_PORT=12345
# The ceiling on the BACKGROUND warm, not on a request. 30s suits the local
# instance; raise it to 90000 if you point at a public mirror.
OVERPASS_TIMEOUT_MS=30000

# --- Unsplash ---------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --- Worker ---------------------------------------------------------------
WORKER_PORT=4100
# Hourly fuel price scrape.
FUEL_SCRAPE_CRON=0 * * * *
# Parallel image derivation jobs. libvips is itself threaded, so this is not the
# whole story — see the sharp.concurrency call in apps/worker/src/index.ts.
IMAGE_CONCURRENCY=3
# Sweeps abandoned uploads. Hourly, at 17 past.
IMAGE_CLEANUP_CRON=17 * * * *
IMAGE_CLEANUP_AFTER_HOURS=24
# How often to look for PENDING image rows that nothing is processing, in ms.
# This is what closes the Postgres/Redis dual write — see DECISIONS.md D40.
IMAGE_RECONCILE_INTERVAL_MS=60000

# --- Web (Vite — VITE_* is exposed to the browser, never put secrets here) -
VITE_API_BASE_URL=http://localhost:4000
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# The dark map. The pair follows the app theme unless the user overrides it
# in their preferences; both are plain style URLs, so a self-hosted tile
# server means changing these two and nothing else. See DECISIONS.md D83.
VITE_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# Must match AUTH_ENABLED_PROVIDERS above: a button for a provider the server
# has not configured only fails at the OAuth redirect.
VITE_AUTH_PROVIDERS=email

# --- Web container (nginx, docker compose) ---------------------------------
WEB_PORT=8080
