{
  "name": "@machiya/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@machiya/db": "workspace:*",
    "@machiya/shared": "workspace:*",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4",
    "sharp": "^0.35.4",
    "@aws-sdk/client-s3": "^3.1124.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@testcontainers/postgresql": "^12.1.0",
    "testcontainers": "^12.1.0"
  }
}
