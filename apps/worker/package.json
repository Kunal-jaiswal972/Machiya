{
  "name": "@machiya/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@machiya/db": "workspace:*",
    "@machiya/shared": "workspace:*",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    "./jobs/process-image": {
      "types": "./dist/jobs/process-image.d.ts",
      "import": "./dist/jobs/process-image.js"
    },
    "./jobs/notify-enquiry": {
      "types": "./dist/jobs/notify-enquiry.d.ts",
      "import": "./dist/jobs/notify-enquiry.js"
    }
  }
}
