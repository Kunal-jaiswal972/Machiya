{
  "name": "machiya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Office-centric rental discovery and listing platform",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build:packages": "pnpm -F @machiya/shared build && pnpm -F @machiya/db build",
    "predev": "pnpm build:packages",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"pnpm -F @machiya/api dev\" \"pnpm -F @machiya/worker dev\" \"pnpm -F @machiya/web dev\"",
    "dev:api": "pnpm -F @machiya/api dev",
    "dev:web": "pnpm -F @machiya/web dev",
    "dev:worker": "pnpm -F @machiya/worker dev",
    "build": "pnpm -r --sequential build",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r --sequential typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --sequential test",
    "clean": "pnpm -r exec rimraf dist node_modules/.cache && rimraf node_modules",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:validate": "prisma validate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --force --schema=packages/db/prisma/schema.prisma && pnpm db:seed",
    "db:seed": "tsx --env-file-if-exists=.env packages/db/prisma/seed.ts",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "auth:generate": "better-auth generate --config apps/api/src/auth/index.ts --output packages/db/prisma/schema.prisma -y",
    "auth:check": "tsx --env-file-if-exists=.env apps/api/scripts/check-auth-schema.ts",
    "auth:routes": "curl -s $BETTER_AUTH_URL/api/auth/open-api/generate-schema | node -e \"let d='';process.stdin.on('data',c=>d+=c).on('end',()=>console.log(Object.keys(JSON.parse(d).paths).sort().join(String.fromCharCode(10))))\"",
    "compose:up": "docker compose up -d",
    "compose:up:geo": "docker compose --profile geo up -d",
    "compose:down": "docker compose down",
    "compose:nuke": "docker compose down -v",
    "compose:logs": "docker compose logs -f",
    "bootstrap": "bash scripts/bootstrap.sh",
    "geo:manifest": "tsx --env-file-if-exists=.env scripts/geo-manifest.ts write",
    "cities:validate": "tsx --env-file-if-exists=.env scripts/validate-cities.ts",
    "cities:boundaries": "tsx --env-file-if-exists=.env scripts/fetch-city-boundaries.ts",
    "geo:status": "tsx --env-file-if-exists=.env scripts/geo-status.ts",
    "prepare": "husky",
    "seed:photos": "tsx --env-file-if-exists=.env scripts/fetch-seed-photos.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.prisma": [
      "prisma format --schema"
    ]
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/js": "^9.39.5",
    "@machiya/shared": "workspace:*",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "zod": "^4.5.4"
  }
}
