{
  "name": "@machiya/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cities": {
      "types": "./dist/cities/index.d.ts",
      "import": "./dist/cities/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "import": "./dist/images/index.js"
    },
    "./auth-access": {
      "types": "./dist/auth-access/index.d.ts",
      "import": "./dist/auth-access/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^4.5.4",
    "file-type": "^22.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "better-auth": "^1.7.2",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "sharp": "^0.35.4",
    "better-auth": "^1.7.2"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  }
}
