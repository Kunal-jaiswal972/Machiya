{
  "name": "@machiya/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "generate": "pnpm -w run db:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rimraf dist generated",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@machiya/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@testcontainers/postgresql": "^12.1.0",
    "better-auth": "^1.7.2",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
