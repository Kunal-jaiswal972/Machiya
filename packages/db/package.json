{
  "name": "@machiya/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json && node scripts/copy-runtime.mjs",
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist generated"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@machiya/shared": "workspace:*",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
