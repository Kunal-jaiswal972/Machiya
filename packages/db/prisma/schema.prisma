// Machiya / RentNear data model.
//
// Three rules govern every geo model in this file, and each of them is easy to
// get wrong:
//
//  1. Prisma cannot SELECT an `Unsupported(...)` field, so each geo model stores
//     `lat`/`lng` as plain Floats alongside the `location geography(Point, 4326)`
//     column. The Float pair is what the API reads and returns; the geography
//     column exists purely so PostGIS can index and query it.
//  2. The two are kept in sync by a Postgres trigger, never by application code.
//     See DECISIONS.md D2 and the hand-written migration
//     `..._location_sync_trigger/migration.sql`.
//  3. `location` is declared OPTIONAL even though it is never null in practice.
//     A REQUIRED Unsupported() field makes Prisma drop the model's `create`
//     operation entirely, which would leave no way to write a listing at all.
//     The NOT NULL guarantee is therefore a CHECK constraint in that same
//     migration. See DECISIONS.md D15.
//
// The GiST indexes, by contrast, ARE expressible in this schema
// (`@@index([location], type: Gist)`) and live here rather than in the
// hand-written migration. See DECISIONS.md D13.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// No `url` here: Prisma 7 moved the connection string into `prisma.config.ts`
// at the repo root. No `extensions` either — the `postgresqlExtensions` preview
// feature is gone in 7, so `postgis` and `pg_trgm` are created by plain SQL in
// the init migration and Prisma no longer tracks them. See DECISIONS.md D5.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  SEEKER
  LISTER
  ADMIN
}

enum ListingType {
  RENT
  SALE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  RENTED
}

enum FurnishingType {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  BUILDER_FLOOR
  VILLA
  STUDIO
  PENTHOUSE
  PG
}

enum EnquiryStatus {
  OPEN
  RESPONDED
  CLOSED
  SPAM
}

enum FuelType {
  PETROL
  DIESEL
  CNG
}

/// Lifecycle of an uploaded photo. Uploads land in a private prefix and are not
/// trusted until the worker has decoded their bytes, so PENDING is not merely
/// "not resized yet" — it is "not yet known to be an image at all".
enum ImageStatus {
  PENDING
  READY
  REJECTED
  FAILED
}

model City {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  state       String
  centroidLat Float
  centroidLng Float

  /// [CityBbox] — { minLng, minLat, maxLng, maxLat }, the ADMINISTRATIVE bounds.
  /// The padded box the artifacts are cut from is derived in the city config
  /// and deliberately not stored: nothing in the database queries it. See D47.
  bbox Json

  /// The administrative boundary, used to assign a listing to a city by
  /// containment rather than by nearest centroid (D50).
  ///
  /// Optional here for the same reason every `location` column is: a REQUIRED
  /// `Unsupported()` field makes Prisma drop the model's `create` operation
  /// entirely (D15). Well-formedness is the `city_boundary_has_area` CHECK in
  /// the migration, and every read goes through `packages/db/src/geo-queries.ts`
  /// because Prisma cannot SELECT this column at all.
  boundary Unsupported("geography(MultiPolygon, 4326)")?

  defaultFuelType FuelType @default(PETROL)

  /// [TransitFareConfig] — per-city fares; they change rarely and no free API
  /// exposes them reliably, so they are configuration rather than scraped data.
  transitFareConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings   Listing[]
  fuelPrices FuelPrice[]
  localities Locality[]

  /// Tier 1 of the autocomplete matches city names by trigram. See D39.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  /// Declared here rather than hand-written, like every other spatial index:
  /// Prisma introspects them and would emit a DROP on the next migrate dev
  /// otherwise (D13). This is what makes the ST_Contains lookup index-assisted.
  @@index([boundary], map: "city_boundary_gix", type: Gist)
}

/// A named neighbourhood inside a city.
///
/// These exist as a table, not just as literals in `scripts/cities.ts`, because
/// tier 1 of the autocomplete has to be able to QUERY them — a trigram search
/// over a TypeScript array is not a search. The seed keeps the two in step, and
/// `location` is derived from lat/lng by the same trigger as every other geo
/// model. See D39.
model Locality {
  id     String @id @default(cuid())
  cityId String
  slug   String
  name   String
  lat    Float
  lng    Float

  location Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([location], map: "locality_location_gix", type: Gist)
}

/// Application user. Better Auth owns the identity columns (id, email,
/// emailVerified, name, avatarUrl, the ban trio) and its session/account tables
/// are generated alongside this model in step 3; `avatarUrl` is mapped from
/// Better Auth's `image` field in the auth config rather than duplicated here.

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  avatarUrl     String?
  role          UserRole @default(SEEKER)

  phone           String?
  isPhoneVerified Boolean @default(false)

  /// [CommutePreferences] — fuel type, vehicle class, mileage, trips per day
  /// and working days per month, as the commute panel last had them.
  ///
  /// A JSON column rather than five columns or a side table, because nothing
  /// queries or aggregates these: they are read whole for one user and written
  /// whole by one form. The shape is validated by
  /// `commutePreferencesSchema` on the way in and on the way out, so a stale
  /// blob from an older shape fails loudly at the boundary rather than
  /// producing a commute cost from a missing mileage. Null means "never
  /// touched", which is different from "set to the defaults" — the panel says
  /// so. See DECISIONS.md D63.
  commutePrefs Json?

  // Better Auth admin plugin.
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offices           OfficeLocation[]
  listings          Listing[]
  favorites         Favorite[]
  savedSearches     SavedSearch[]
  enquiriesAsSeeker Enquiry[]        @relation("EnquirySeeker")
  enquiriesAsLister Enquiry[]        @relation("EnquiryLister")
  messages          EnquiryMessage[]
  listingViews      ListingView[]

  sessions Session[]
  accounts Account[]

  @@index([role])
}

/// A saved office. `location` is derived from lat/lng by trigger.

model OfficeLocation {
  id      String @id @default(cuid())
  userId  String
  label   String
  address String
  lat     Float
  lng     Float

  location Unsupported("geography(Point, 4326)")?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@index([location], map: "office_location_gix", type: Gist)
}

model Listing {
  id      String @id @default(cuid())
  slug    String @unique
  ownerId String
  cityId  String

  /// Null until the wizard's step that collects it. Every nullable column on
  /// this model is nullable for that one reason: a draft is genuinely
  /// incomplete, and a placeholder title is a lie the rest of the code then has
  /// to believe. The `listing_complete_when_live` CHECK in the migration makes
  /// all of them NOT NULL the moment status leaves DRAFT. See DECISIONS.md D67.
  title       String?
  description String?

  /// Defaulted rather than nullable: this is a rentals product, the wizard
  /// shows the real choice on its second step, and a two-value enum has no
  /// honest null. See D67.
  listingType  ListingType   @default(RENT)
  propertyType PropertyType?
  status       ListingStatus @default(DRAFT)

  /// The street line stays EMPTY after the location step rather than being
  /// filled with a reverse-geocoded approximation, which is one of D59's three
  /// rules. `locality` is prefilled only on a locality-level match.
  address  String?
  locality String?
  lat      Float
  lng      Float

  location Unsupported("geography(Point, 4326)")?

  bedrooms    Int?
  bathrooms   Int?
  floor       Int?
  totalFloors Int?
  areaSqft    Int?

  furnishing FurnishingType?

  /// Whole rupees, not paise: no sub-rupee rent exists in this market and Int
  /// keeps the money out of Decimal serialisation entirely.
  rentAmount         Int?
  salePrice          Int?
  securityDeposit    Int?
  maintenanceMonthly Int?

  availableFrom DateTime?

  isVerified Boolean  @default(false)
  viewCount  Int      @default(0)
  rules      String[] @default([])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  city  City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  amenities ListingAmenity[]
  images    ListingImage[]
  enquiries Enquiry[]
  favorites Favorite[]
  views     ListingView[]

  @@index([cityId])
  @@index([ownerId])
  @@index([cityId, status, listingType])
  @@index([status, rentAmount])
  @@index([ownerId, status])
  @@index([status, publishedAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([location], map: "listing_location_gix", type: Gist)
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String

  /// Object key of the ORIGINAL upload, under the private `originals/` prefix.
  /// Cleared when the original is discarded after derivation.
  objectKey String?

  /// Where this image's public variants live, WITHOUT the `/{size}.{ext}` tail.
  /// Normally `variants/{listingId}/{id}`, but seeded listings share one copy of
  /// a photo under `variants/fixtures/{photoId}` — which is why this is stored
  /// rather than derived from the ids. See DECISIONS.md D41.
  variantBaseKey String

  status        ImageStatus @default(PENDING)
  /// Why a REJECTED or FAILED image did not make it, shown in the wizard.
  failureReason String?
  processedAt   DateTime?

  /// How many times the reconciler has re-enqueued this row (see D40). A row
  /// that keeps coming back without reaching a terminal state becomes FAILED
  /// with a reason rather than being retried forever.
  reconcileAttempts Int @default(0)

  /// Zero until the worker has decoded the image.
  width     Int
  height    Int
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  /// Average colour, as #rrggbb, for the placeholder behind a loading photo.
  dominantColor String?
  /// Tiny inline preview (base64 data URI) so a gallery never flashes empty.
  lqip          String?

  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([listingId, sortOrder])
  /// The cleanup job sweeps stale PENDING rows.
  @@index([status, createdAt])
}

model Amenity {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  icon     String?
  category String

  listings ListingAmenity[]

  @@index([category])
}

model ListingAmenity {
  listingId String
  amenityId String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([listingId, amenityId])
  @@index([amenityId])
}

model Enquiry {
  id        String        @id @default(cuid())
  listingId String
  seekerId  String
  listerId  String
  status    EnquiryStatus @default(OPEN)

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  listing  Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seeker   User             @relation("EnquirySeeker", fields: [seekerId], references: [id], onDelete: Cascade)
  lister   User             @relation("EnquiryLister", fields: [listerId], references: [id], onDelete: Cascade)
  messages EnquiryMessage[]

  /// One thread per seeker per listing; further contact appends messages.
  @@unique([listingId, seekerId])
  @@index([listingId])
  @@index([seekerId])
  @@index([listerId])
  @@index([listerId, status, lastMessageAt])
}

model EnquiryMessage {
  id        String    @id @default(cuid())
  enquiryId String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// When the recipient's email was sent, or null if none was owed.
  ///
  /// This column makes the row its own outbox, exactly as `ListingImage.status`
  /// does for derivation (D40): the mail is enqueued strictly after the commit,
  /// and a reconciler drains anything the enqueue missed. `notifyOwed` is what
  /// separates "no mail was due for this message" from "one was due and has not
  /// been sent" — without it a chatty thread would look identical to a dropped
  /// notification. See DECISIONS.md D68.
  notifyOwed  Boolean   @default(false)
  notifiedAt  DateTime?
  notifyFails Int       @default(0)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
  @@index([senderId])
  @@index([enquiryId, createdAt])
  /// The reconciler's scan: messages owed a mail that has not been sent.
  @@index([notifyOwed, notifiedAt, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model SavedSearch {
  id     String @id @default(cuid())
  userId String
  name   String

  /// [ListingFilters] — the same filter object the search endpoint accepts, so a
  /// saved search is re-run by handing it straight back.
  filters Json

  officeLat     Float
  officeLng     Float
  radiusMeters  Int     @default(3000)
  notifyEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([notifyEnabled])
}

model FuelPrice {
  id       String   @id @default(cuid())
  cityId   String
  fuelType FuelType

  /// Rupees per litre (per kg for CNG), two decimals.
  price     Decimal @db.Decimal(8, 2)
  currency  String  @default("INR")
  source    String
  sourceUrl String

  fetchedAt DateTime
  createdAt DateTime @default(now())

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  /// Latest-per-city lookup: the API reads Redis, but falls back to this.
  @@unique([cityId, fuelType, fetchedAt])
  @@index([cityId])
  @@index([cityId, fuelType, fetchedAt(sort: Desc)])
}

/// Somebody asking for a city the product does not serve yet.
///
/// This table is the reason the out-of-coverage state is worth building rather
/// than just refusing: it is the real signal for which city to add fourth, and
/// a signal is worth more than a dead end. See DECISIONS.md D53.
///
/// `lat`/`lng` are rounded to `COVERAGE_REQUEST_PRECISION` (3 dp, about 110 m)
/// before they are written, and the unique constraint is on the rounded pair —
/// otherwise one person tapping "tell me" on three slightly different pins
/// becomes three rows and the count that decides the fourth city is a count of
/// taps. `location` is derived by the same trigger as every other geo model.
model CoverageRequest {
  id    String @id @default(cuid())
  email String
  lat   Float
  lng   Float

  location Unsupported("geography(Point, 4326)")?

  /// What the geocoder called the point, when anything could. Null for a pin
  /// dropped somewhere unmapped, which is still a perfectly good request.
  placeLabel String?

  /// How many times this person has asked about this point.
  asks Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, lat, lng])
  @@index([createdAt])
  @@index([location], map: "coverage_request_location_gix", type: Gist)
}

model ListingView {
  id        String   @id @default(cuid())
  listingId String
  userId    String?
  viewedAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([userId])
  @@index([listingId, viewedAt])
}

// ---------------------------------------------------------------------------
// Better Auth owns the three models below. They are generated by
// `pnpm auth:generate` (the Better Auth CLI) from apps/api/src/auth, so edit
// that config and regenerate rather than hand-editing here.
//
// Two deliberate departures from the generator's output:
//  - the `@@map` directives it adds are removed, so table names stay PascalCase
//    like the rest of the schema. The Prisma adapter resolves models by Prisma
//    model name, not table name, so this changes nothing for Better Auth.
//  - Session exists at all only because `session.storeSessionInDatabase` is on.
//    Providing secondaryStorage otherwise moves sessions into Redis alone,
//    which would sign everyone out on a Redis restart. See DECISIONS.md D20.
// ---------------------------------------------------------------------------

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  /// Provider issuer, e.g. "local:credential" or an OAuth issuer URL. Required
  /// by better-auth 1.7 and NOT emitted by @better-auth/cli 1.4 — see
  /// `pnpm auth:check` and DECISIONS.md D22.
  issuer                String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
